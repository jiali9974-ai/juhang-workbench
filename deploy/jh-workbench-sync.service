[Unit]
Description=Sync JH workbench from GitHub main and deploy a verified release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/bin/bash /srv/jh-workbench/automation/sync_from_git.sh
TimeoutStartSec=20min
Nice=10
MemoryMax=3G
StandardOutput=journal
StandardError=journal
